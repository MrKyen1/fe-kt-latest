# Biến môi trường cho Kata Web; mọi biến VITE_* đều công khai trong bản build.
# Copy file này thành .env.local để cấu hình máy dev.

# Kết nối API
# URL gốc API mà FE gọi, bao gồm /api/v1; production dùng /api/v1 để Nginx chuyển request trên cùng domain vào BE.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Thông tin ứng dụng
# Tên ứng dụng dự kiến dùng trên FE; hiện source chưa đọc biến này nên đổi giá trị chưa làm thay đổi giao diện.
VITE_APP_NAME=Kata Web
# Phiên bản ứng dụng dự kiến dùng trên FE; hiện source chưa đọc biến này nên chưa tự hiển thị phiên bản.
VITE_APP_VERSION=1.0.0

# Giá trị điền sẵn khi tạo tài khoản
# Mật khẩu mặc định FE điền khi tạo học sinh; giá trị được đóng gói công khai trong bundle, không phải secret.
VITE_DEFAULT_STUDENT_PASSWORD=12345678
# Mật khẩu mặc định FE điền khi tạo giáo viên; giá trị được đóng gói công khai trong bundle, không phải secret.
VITE_DEFAULT_TEACHER_PASSWORD=Demo@123456

